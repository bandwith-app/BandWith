# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.vite/

# Environment variables
.env
.env.local
.env.*.local

# Private keys (Apple Sign-In .p8, certificates): never commit
*.p8
*.pem
*.p12

# IDE
.idea/
.vscode/
.continue/
*.swp
*.swo
.DS_Store

# Logs
*.log
npm-debug.log*

# Testing
coverage/

# Capacitor (native projects are tracked; build outputs are ignored by android/.gitignore)
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/.idea/
android/app/google-services.json
*.apk
*.aab

# Supabase CLI cache
supabase/.temp/

# Email template builder output (previews with inlined logos)
supabase/email-templates/_source/out/
supabase/email-templates/_legacy/

# Android release output (scripts/release-android.sh)
dist-android/

# End-to-end suite (Playwright): demo build, results, report
e2e/.app/
e2e/.results*/
e2e/.report/
e2e/RESUME.md

# Screen-map crawler output (a small sample is committed)
e2e/crawl/out/*
!e2e/crawl/out/sample/

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (sb_publishable_…) from Settings → API Keys. Never the secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Google venue search no longer uses a VITE_ key: the key is the server secret
# GOOGLE_PLACES_API_KEY of the `places` edge function. Without it the app uses OpenStreetMap.

# Development only: run on local sample data instead of Supabase (any sign-in opens the demo account).
# Also turns on automatically in `npm run dev` when the two Supabase variables above are missing.
# VITE_DEMO_MODE=true
